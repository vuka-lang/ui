package ui

// BadgeProps configures a Badge; Children is its label.
type BadgeProps struct {
	// Variant is the tone: Default, Primary, Success, Danger, Warning or Info.
	Variant Variant
	// Soft tints the badge (a light background with coloured text) instead of
	// filling it.
	Soft     bool
	Class    string
	Children Node
}

// Badge is a small status pill:
//
//	ui.Badge(ui.BadgeProps{Variant: ui.Success, Children: ui.Text("Signed")})
//	ui.Badge(ui.BadgeProps{Variant: ui.Danger, Soft: true, Children: ui.Text("Failed")})
func Badge(p BadgeProps) Node {
	class := "vk-badge"
	if p.Variant != "" {
		class += " vk-badge--" + string(p.Variant)
	}
	if p.Soft {
		class += " vk-badge--soft"
	}
	if p.Class != "" {
		class += " " + p.Class
	}
	return <span class={class}>{p.Children}</span>
}
