package ui

import "strconv"

// Tab is one tab of a Tabs bar. It is driven either by Href (navigation) or
// by On (a live event handler); set one.
type Tab struct {
	Label string
	// Icon is an optional named icon before the label, e.g. "users".
	Icon string
	// Count, when set, shows as a badge beside the label (see ui.Count).
	Count *int
	// Href makes the tab a link. Patch asks the live page to re-bind the same
	// route with the new URL rather than mount afresh.
	Href  string
	Patch bool
	// On is a live event handler the tab calls when it has no Href.
	On any
	// Active marks the current tab.
	Active bool
	ID     string
}

// Count boxes n for a Tab's badge.
func Count(n int) *int { return &n }

// TabsProps configures a Tabs bar.
type TabsProps struct {
	Tabs  []Tab
	Class string
}

// Tabs is a tab bar underlining the active tab; each tab may carry a count:
//
//	ui.Tabs(ui.TabsProps{Tabs: []ui.Tab{
//		{Label: "Placements", Href: "/tasks?type=placements", Active: true, Count: ui.Count(42)},
//		{Label: "Permits", Href: "/tasks?type=permits", Count: ui.Count(7)},
//	}})
func Tabs(p TabsProps) Node {
	class := "vk-tabs"
	if p.Class != "" {
		class += " " + p.Class
	}
	var tabs []Node
	for _, t := range p.Tabs {
		tabs = append(tabs, tabNode(t))
	}
	return <div class={class} role="tablist">{tabs}</div>
}

func tabNode(t Tab) Node {
	tabClass := "vk-tab"
	if t.Active {
		tabClass += " vk-tab--active"
	}
	var label []Node
	if t.Icon != "" {
		label = append(label, <span class="vk-tab__icon">{Icon(t.Icon)}</span>)
	}
	label = append(label, <span class="vk-tab__label">{Text(t.Label)}</span>)
	if t.Count != nil {
		label = append(label, <span class="vk-tab__count">{Text(strconv.Itoa(*t.Count))}</span>)
	}

	if t.Href != "" {
		mark := any(true)
		if t.Patch {
			mark = "patch"
		}
		attrs := []Attr{{"class", tabClass}, {"href", t.Href}, {"data-vk-link", mark},
			{"role", "tab"}, {"aria-selected", strconv.FormatBool(t.Active)}}
		attrs = appendIf(attrs, t.ID != "", Attr{"id", t.ID})
		return El("a", attrs, label...)
	}
	attrs := []Attr{{"type", "button"}, {"class", tabClass}, {"role", "tab"},
		{"aria-selected", strconv.FormatBool(t.Active)}}
	attrs = appendIf(attrs, t.ID != "", Attr{"id", t.ID})
	if t.On != nil {
		attrs = append(attrs, Attr{"onClick", On(t.On)})
	}
	return El("button", attrs, label...)
}
