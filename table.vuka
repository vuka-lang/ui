package ui

import "strconv"

// Column describes one column of a Table or DataTable over rows of type T.
type Column[T any] struct {
	// Header is the heading cell's content.
	Header Node
	// Cell renders a row's cell in this column.
	Cell func(T) Node
	// Align is "", "right" or "center".
	Align string
	// Class is added to every cell (header and body) in this column.
	Class string
	// Sort, when set, is the column's sort key: DataTable renders the header
	// as a sort control that calls its OnSort with this key. Table ignores it.
	Sort string
}

// TableProps configures a Table over rows of type T.
type TableProps[T any] struct {
	Columns []Column[T]
	Rows    []T
	// RowKey gives each row a stable key for the live diff (the row's id).
	RowKey func(T) any
	// RowHref, when set, makes a row navigate to it on click (over the live
	// connection when connected).
	RowHref func(T) string
	// RowActions, when set, adds a trailing column rendering per-row controls.
	RowActions func(T) Node

	// Selectable adds a leading checkbox column. With OnSelect the boxes are
	// live (ticked by RowSelected, toggled through OnSelect); without it they
	// are plain form checkboxes named SelectName (default "selected") with the
	// row's RowKey as value, for a form or handler to read.
	Selectable bool
	SelectName string
	// RowSelected is a live checkbox's ticked state, and highlights the row.
	RowSelected func(T) bool
	// OnSelect is the live handler a row's checkbox calls; it receives the row
	// and returns the handler to run (a func, as an on… attribute takes).
	OnSelect func(T) any
	// OnSelectAll is the header checkbox's handler (select or clear the page).
	OnSelectAll any
	// AllSelected ticks the header checkbox; SomeSelected marks it mixed.
	AllSelected  bool
	SomeSelected bool

	// Index adds a leading row-number column. IndexFrom is the number before
	// the first row (0 numbers the first row 1); DataTable sets it from the
	// page.
	Index     bool
	IndexFrom int

	// Empty is shown in place of the body when there are no rows; a default
	// message is used when nil. EmptyIcon is shown above it.
	Empty     Node
	EmptyIcon Node

	// Flush drops the table's outer border and side padding so it sits flush
	// in a Card (use with CardProps.NoPad).
	Flush bool
	Class string
}

// Table renders rows of type T as an HTML table styled with the --ui-*
// tokens. It is presentational — DataTable adds paging, search and sort:
//
//	ui.Table(ui.TableProps[Book]{
//		Columns: []ui.Column[Book]{
//			{Header: ui.Text("Title"), Cell: func(b Book) ui.Node { return ui.Text(b.Title) }},
//			{Header: ui.Text("Author"), Cell: func(b Book) ui.Node { return ui.Text(b.Author) }},
//		},
//		Rows:   books,
//		RowKey: func(b Book) any { return b.ID },
//	})
func Table[T any](p TableProps[T]) Node {
	class := "vk-table"
	if p.Flush {
		class += " vk-table--flush"
	}
	if p.Class != "" {
		class += " " + p.Class
	}
	span := len(p.Columns)
	if p.Selectable {
		span++
	}
	if p.Index {
		span++
	}
	if p.RowActions != nil {
		span++
	}

	table := <table class={class}><thead><tr>{headerCells(p)}</tr></thead>{tableBody(p, span)}</table>
	return <div class="vk-table-wrap">{table}</div>
}

func headerCells[T any](p TableProps[T]) []Node {
	var cells []Node
	if p.Selectable {
		cells = append(cells, <th class="vk-col--center vk-col--select" scope="col">{selectAll(p)}</th>)
	}
	if p.Index {
		cells = append(cells, <th class="vk-col--center vk-col--index" scope="col">{Text("#")}</th>)
	}
	for _, c := range p.Columns {
		cells = append(cells, El("th", thAttrs(c), c.Header))
	}
	if p.RowActions != nil {
		cells = append(cells, <th class="vk-col--right" scope="col" aria-label="Actions"></th>)
	}
	return cells
}

func selectAll[T any](p TableProps[T]) Node {
	if p.OnSelectAll == nil {
		return nil
	}
	attrs := []Attr{{"type", "checkbox"}, {"class", "vk-check__box"}, {"aria-label", "Select all"}}
	if p.AllSelected {
		attrs = append(attrs, Attr{"checked", true})
	}
	if p.SomeSelected && !p.AllSelected {
		attrs = append(attrs, Attr{"aria-checked", "mixed"}, Attr{"data-vk-mixed", "true"})
	}
	attrs = append(attrs, Attr{"onClick", On(p.OnSelectAll)})
	return El("input", attrs)
}

func thAttrs[T any](c Column[T]) []Attr {
	return []Attr{{"scope", "col"}, {"class", colClass(c)}}
}

func colClass[T any](c Column[T]) string {
	class := ""
	switch c.Align {
	case "right":
		class = "vk-col--right"
	case "center":
		class = "vk-col--center"
	}
	if c.Class != "" {
		if class != "" {
			class += " "
		}
		class += c.Class
	}
	return class
}

func tableBody[T any](p TableProps[T], span int) Node {
	if len(p.Rows) == 0 {
		return <tbody><tr><td colspan={span} class="vk-table__empty">{emptyState(p)}</td></tr></tbody>
	}
	name := p.SelectName
	if name == "" {
		name = "selected"
	}
	var rows []Node
	for i, row := range p.Rows {
		var cells []Node
		if p.Selectable {
			cells = append(cells, selectCell(p, row, name))
		}
		if p.Index {
			cells = append(cells, <td class="vk-col--center vk-col--index">{Text(strconv.Itoa(p.IndexFrom+i+1))}</td>)
		}
		for _, c := range p.Columns {
			cells = append(cells, <td class={colClass(c)}>{cellNode(c, row)}</td>)
		}
		if p.RowActions != nil {
			cells = append(cells, <td class="vk-col--right vk-col--actions">{p.RowActions(row)}</td>)
		}
		rows = append(rows, El("tr", rowAttrs(p, row), cells...))
	}
	return <tbody>{rows}</tbody>
}

func rowAttrs[T any](p TableProps[T], row T) []Attr {
	var attrs []Attr
	if p.RowKey != nil {
		attrs = append(attrs, Attr{"key", p.RowKey(row)})
	}
	class := ""
	if p.RowHref != nil {
		class = "vk-row--link"
	}
	if p.RowSelected != nil && p.RowSelected(row) {
		if class != "" {
			class += " "
		}
		class += "vk-row--selected"
	}
	if class != "" {
		attrs = append(attrs, Attr{"class", class})
	}
	if p.RowHref != nil {
		attrs = append(attrs, Attr{"onClick", On(JS.Navigate(p.RowHref(row)))})
	}
	return attrs
}

// selectCell renders a row's checkbox. A click on it is answered by the box's
// own handler alone — the live runtime dispatches the nearest handler, so a
// box inside a navigable row doesn't also trigger the row.
func selectCell[T any](p TableProps[T], row T, name string) Node {
	attrs := []Attr{{"type", "checkbox"}, {"class", "vk-check__box"}, {"aria-label", "Select row"}}
	if p.RowKey != nil {
		attrs = append(attrs, Attr{"value", Text(p.RowKey(row))})
	}
	if p.OnSelect != nil {
		if p.RowSelected != nil && p.RowSelected(row) {
			attrs = append(attrs, Attr{"checked", true})
		}
		attrs = append(attrs, Attr{"onClick", On(p.OnSelect(row))})
	} else {
		attrs = append(attrs, Attr{"name", name})
	}
	return <td class="vk-col--center vk-col--select">{El("input", attrs)}</td>
}

func emptyState[T any](p TableProps[T]) Node {
	msg := p.Empty
	if msg == nil {
		msg = Text("Nothing to show.")
	}
	if p.EmptyIcon == nil {
		return msg
	}
	return <div class="vk-empty"><span class="vk-empty__icon">{p.EmptyIcon}</span><span class="vk-empty__msg">{msg}</span></div>
}

func cellNode[T any](c Column[T], row T) Node {
	if c.Cell == nil {
		return nil
	}
	return c.Cell(row)
}
