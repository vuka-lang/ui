package ui_test

import (
	"context"
	"errors"
	"strconv"
	"strings"
	"testing"

	"github.com/vuka-lang/ui"
	"github.com/vuka-lang/ui/live"
	"github.com/vuka-lang/ui/live/livetest"
)

type Pet struct {
	Name string
	Age  int
}

func PetRow(pet Pet) ui.Node {
	return <tr><td>{pet.Name}</td><td>{pet.Age}</td></tr>
}

func Pets(pets []Pet, children ui.Node) ui.Node {
	return <table className="pets">
		{for _, p := range pets { <PetRow pet={p} /> }}
		{if len(pets) == 0 { <tr><td>none</td></tr> }}
		{children}
	</table>
}

func Avatar(url string) (ui.Node, error) {
	if url == "" {
		return nil, errors.New("no avatar")
	}
	return <img src={url} />, nil
}

type Clicks struct {
	ui.Live
	Start int
	n     int
}

func (c *Clicks) Mount()          { c.n = c.Start }
func (c *Clicks) Inc()            { c.n++ }
func (c *Clicks) Render() ui.Node { return <button onClick={c.Inc}>{c.n}</button> }

// TestJSX: ui is a JSX target — the compiler lowers a file importing it to
// ui's nodes, components bind by name, stateful tags render statically.
func TestJSX(t *testing.T) {
	ctx := context.Background()
	cases := []struct {
		n    ui.Node
		want string
	}{
		{<Pets pets={[]Pet{{"Rex", 3}}}><caption>pets</caption></Pets>, `<table class="pets"><tr><td>Rex</td><td>3</td></tr><caption>pets</caption></table>`},
		{<Pets />, `<table class="pets"><tr><td>none</td></tr></table>`},
		{<p><Avatar url="/a.png" /></p>, `<p><img src="/a.png"></p>`},
		{<Clicks Start={4} />, `<button>4</button>`},
	}
	for _, c := range cases {
		if got, err := ui.String(ctx, c.n); err != nil || got != c.want {
			t.Errorf("got %q (%v), want %q", got, err, c.want)
		}
	}
	if _, err := ui.String(ctx, <p><Avatar /></p>); err == nil || err.Error() != "no avatar" {
		t.Errorf("a component's error fails the render: %v", err)
	}
}

type Dropdown struct {
	ui.Live
	opened int
}

func (d *Dropdown) Opened() { d.opened++ }

func (d *Dropdown) Render() ui.Node {
	return <div>
		<button onClick={ui.JS.On(ui.Ref("menu")).RemoveClass("hidden").Push(d.Opened)}>Open</button>
		<ul ref="menu" class="hidden" onKeyDown={ui.JS.Key("Escape").AddClass(ui.This, "hidden")}><li>{d.opened}</li></ul>
	</div>
}

// TestJSXCommands: a chain is an on… attribute's value, compiled through
// the event check; ref renders as data-vk-ref.
func TestJSXCommands(t *testing.T) {
	got, err := ui.String(context.Background(), <Dropdown />)
	want := `<div><button data-vk-js-click="[[&#34;remove_class&#34;,{&#34;to&#34;:{&#34;ref&#34;:&#34;menu&#34;},&#34;names&#34;:[&#34;hidden&#34;]}],[&#34;push&#34;,{}]]">Open</button>` +
		`<ul data-vk-ref="menu" class="hidden" data-vk-js-keydown="[[&#34;key&#34;,{&#34;keys&#34;:[&#34;Escape&#34;]}],[&#34;add_class&#34;,{&#34;names&#34;:[&#34;hidden&#34;]}]]"><li>0</li></ul></div>`
	if err != nil || got != want {
		t.Errorf("got  %s (%v)\nwant %s", got, err, want)
	}
}

type Modal struct {
	ui.Live
	saved int
	items []string
}

func (m *Modal) Save()          { m.saved++ }
func (m *Modal) Pick(i int)     { m.saved = i }
func (m *Modal) Delete(s string) {}

func (m *Modal) Render() ui.Node {
	open := ui.JS.PushFocus().Show(ui.Ref("dialog"), ui.Display("flex")).FocusFirst(ui.Ref("dialog"))
	close := ui.JS.Hide(ui.Ref("dialog")).PopFocus()
	return <div>
		<button onClick={open}>Edit</button>
		<input type="checkbox" ref="all" onChange={ui.JS.
			If(ui.Ref("all").Checked()).RemoveClass(ui.Ref("dialog"), "hidden").
			Else().AddClass(ui.Ref("dialog"), "hidden").
			End()} />
		<div ref="dialog" style="display: none" onKeyDown={ui.JS.Key("Escape").Hide(ui.Ref("dialog")).PopFocus()}>
			<button onClick={close}>Cancel</button>
			<button onClick={close.Push(m.Save)}>Save</button>
			<button onClick={ui.JS.Push(m.Pick, ui.Value(7))}>Seven</button>
			{for _, it := range m.items {
				<button onClick={ui.JS.Confirm("Delete " + it + "?").Push(func() { m.Delete(it) })}>{it}</button>
			}}
		</div>
	</div>
}

func TestJSXModal(t *testing.T) {
	got, err := ui.String(context.Background(), <Modal />)
	if err != nil || !strings.Contains(got, `data-vk-ref="dialog"`) || !strings.Contains(got, `data-vk-js-change="[[&#34;if&#34;`) {
		t.Errorf("%s (%v)", got, err)
	}
}

// Post counts a like before the server confirms it: the click shows the
// new count, and a failed Like takes it back and shows the error.
type Post struct {
	ui.Live
	Fail  *bool // the next Like fails
	likes ui.Assign[int]
}

func (c *Post) Like() error {
	if *c.Fail {
		*c.Fail = false
		return errors.New("try again")
	}
	c.likes.Set(c.likes.Get() + 1)
	return nil
}

func (c *Post) Render() ui.Node {
	return <article>
		<button onClick={ui.JS.
			AddClass(ui.This, "liked").
			SetText(ui.Ref("likes"), strconv.Itoa(c.likes.Get()+1)).
			Push(c.Like).
			OnError(ui.JS.Show(ui.Ref("like-error"))).
			OnSuccess(ui.JS.Dispatch(ui.This, "liked"))}>
			♥ <span ref="likes">{c.likes.Get()}</span>
		</button>
		<p ref="like-error" style="display: none">Couldn't like</p>
	</article>
}

func TestJSXOptimistic(t *testing.T) {
	fail := false
	c, err := livetest.Join(live.NewSession(context.Background(), func(context.Context) ui.Node { return <Post Fail={&fail} /> }), 2)
	if err != nil {
		t.Fatal(err)
	}
	c.Hold()
	c.Click("button")
	if c.Text("span") != "1" || !c.HasClass("button", "liked") {
		t.Fatalf("predicted: %s", c.HTML())
	}
	c.Deliver()
	if c.Text("span") != "1" || c.Visible("p") {
		t.Fatalf("confirmed: %s", c.HTML())
	}
	fail = true
	c.Click("button")
	if c.Text("span") != "2" {
		t.Fatalf("predicted: %s", c.HTML())
	}
	c.Deliver()
	if c.Text("span") != "1" || !c.Visible("p") || !c.HasClass("button", "liked") {
		t.Fatalf("reverted to the server's count and class, error shown: %s", c.HTML())
	}
}
