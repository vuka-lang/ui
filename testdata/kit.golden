  background:var(--ui-bg);color:var(--ui-fg);border:0;box-shadow:var(--ui-shadow)}
dialog.vk-drawer::backdrop{background:var(--ui-overlay)}
.vk-drawer--right{inset:0 0 0 auto} .vk-drawer--left{inset:0 auto 0 0}
.vk-drawer--bottom{inset:auto 0 0 0;width:100vw;height:auto;max-height:80vh}
dialog.vk-drawer[data-vk-size="lg"]{width:min(40rem,100vw)} dialog.vk-drawer[data-vk-size="xl"],dialog.vk-drawer[data-vk-size="full"]{width:100vw}
dialog.vk-popover{position:fixed;margin:0;padding:0;max-width:min(22rem,calc(100vw - 1rem));background:var(--ui-bg);color:var(--ui-fg);
  border:var(--ui-border-width) solid var(--ui-border);border-radius:var(--ui-radius);box-shadow:var(--ui-shadow);z-index:var(--ui-z-popover)}
.vk-popover .vk-dialog__body{padding:calc(var(--ui-space) * 3) calc(var(--ui-space) * 4)}
.vk-call-inline{border:var(--ui-border-width) solid var(--ui-border);border-radius:var(--ui-radius);background:var(--ui-bg);color:var(--ui-fg)}
#vk-overlays{position:fixed;z-index:var(--ui-z-toast);right:0;bottom:0;display:flex;flex-direction:column-reverse;gap:calc(var(--ui-space) * 2);padding:calc(var(--ui-space) * 4);max-width:min(24rem,100vw);pointer-events:none}
#vk-overlays dialog,#vk-overlays [data-vk-present="toast"]{pointer-events:auto}
.vk-confirm .vk-dialog__body p{margin:0}

/* Alert */
.vk-alert{display:flex;gap:calc(var(--ui-space) * 3);align-items:flex-start;padding:calc(var(--ui-space) * 3) calc(var(--ui-space) * 4);border:var(--ui-border-width) solid var(--ui-border);
  border-left-width:var(--ui-accent-width);border-radius:var(--ui-radius);background:var(--ui-subtle);color:var(--ui-fg)}
.vk-alert__body{flex:1;min-width:0}
.vk-alert__title{font-weight:var(--ui-weight-semibold);margin:0 0 calc(var(--ui-space) * 0.6)}
.vk-alert__close{appearance:none;border:0;background:transparent;color:inherit;opacity:var(--ui-opacity-dismiss);cursor:pointer;font-size:var(--ui-font-dismiss);line-height:1}
.vk-alert__close:hover{opacity:1}
.vk-alert--info{border-left-color:var(--ui-info);background:var(--ui-info-bg)}
.vk-alert--success{border-left-color:var(--ui-success);background:var(--ui-success-bg)}
.vk-alert--warning{border-left-color:var(--ui-warning);background:var(--ui-warning-bg)}
.vk-alert--error{border-left-color:var(--ui-danger);background:var(--ui-danger-bg)}

/* Toasts */
.vk-toasts{position:fixed;z-index:var(--ui-z-toast);display:flex;flex-direction:column;gap:calc(var(--ui-space) * 2);padding:calc(var(--ui-space) * 4);max-width:min(24rem,100vw);pointer-events:none}
.vk-toasts--top-right{top:0;right:0} .vk-toasts--top-left{top:0;left:0}
.vk-toasts--bottom-right{bottom:0;right:0;flex-direction:column-reverse}
.vk-toasts--bottom-left{bottom:0;left:0;flex-direction:column-reverse}
.vk-toast{pointer-events:auto;display:flex;gap:calc(var(--ui-space) * 3);align-items:flex-start;padding:calc(var(--ui-space) * 3) calc(var(--ui-space) * 4);border:var(--ui-border-width) solid var(--ui-border);
  border-left-width:var(--ui-accent-width);border-radius:var(--ui-radius);background:var(--ui-bg);color:var(--ui-fg);box-shadow:var(--ui-shadow)}
.vk-toast__body{flex:1;min-width:0}
.vk-toast__title{font-weight:var(--ui-weight-semibold);margin:0 0 calc(var(--ui-space) * 0.6)}
.vk-toast__close{appearance:none;border:0;background:transparent;color:inherit;opacity:var(--ui-opacity-dismiss);cursor:pointer;font-size:var(--ui-font-dismiss);line-height:1}
.vk-toast__close:hover{opacity:1}
.vk-toast--info{border-left-color:var(--ui-info)} .vk-toast--success{border-left-color:var(--ui-success)}
.vk-toast--warning{border-left-color:var(--ui-warning)} .vk-toast--error{border-left-color:var(--ui-danger)}
.vk-toast[style*="--vk-toast-life"]{animation:vk-toast-out var(--ui-motion-toast) var(--vk-toast-life) forwards}
@keyframes vk-toast-out{to{opacity:0;transform:translateY(-.25rem);visibility:hidden}}
@media (prefers-reduced-motion:reduce){.vk-toast{animation:none}}

/* Table + DataTable */
.vk-table-wrap{width:100%;overflow-x:auto}
.vk-table{width:100%;border-collapse:collapse;color:var(--ui-fg);font-size:var(--ui-font-table)}
.vk-table th,.vk-table td{padding:calc(var(--ui-space) * 2.4) calc(var(--ui-space) * 3);text-align:left;border-bottom:var(--ui-border-width) solid var(--ui-border);vertical-align:middle}
.vk-table thead th{color:var(--ui-muted);font-weight:var(--ui-weight-semibold);font-size:var(--ui-font-small);text-transform:uppercase;letter-spacing:var(--ui-tracking-heading)}
.vk-table tbody tr:hover{background:var(--ui-subtle)}
.vk-table td.vk-col--right,.vk-table th.vk-col--right{text-align:right}
.vk-table td.vk-col--center,.vk-table th.vk-col--center{text-align:center}
.vk-table tr.vk-row--link{cursor:pointer}
.vk-table__empty{padding:calc(var(--ui-space) * 8);text-align:center;color:var(--ui-muted)}
.vk-sort{appearance:none;border:0;background:transparent;color:inherit;font:var(--ui-font,inherit);font-weight:var(--ui-weight-semibold);cursor:pointer;display:inline-flex;gap:calc(var(--ui-space) * 1.2);align-items:center;text-transform:inherit;letter-spacing:inherit}
.vk-sort__ind{color:var(--ui-primary)}
.vk-datatable{display:flex;flex-direction:column;gap:calc(var(--ui-space) * 3)}
.vk-datatable__bar{display:flex;gap:calc(var(--ui-space) * 3);align-items:center;flex-wrap:wrap;justify-content:space-between}
.vk-datatable__search{flex:1;min-width:12rem;max-width:20rem;padding:calc(var(--ui-space) * 1.8) calc(var(--ui-space) * 2.4);border:var(--ui-border-width) solid var(--ui-border);border-radius:var(--ui-radius);background:var(--ui-bg);color:var(--ui-fg)}
.vk-datatable__foot{display:flex;gap:calc(var(--ui-space) * 3);align-items:center;justify-content:space-between;flex-wrap:wrap;color:var(--ui-muted);font-size:var(--ui-font-meta)}
.vk-pager{display:flex;gap:var(--ui-space);align-items:center}
.vk-pager button,.vk-pager a{appearance:none;cursor:pointer;min-width:2rem;padding:calc(var(--ui-space) * 1.4) calc(var(--ui-space) * 2.2);border:var(--ui-border-width) solid var(--ui-border);border-radius:var(--ui-radius);background:var(--ui-bg);color:var(--ui-fg);text-decoration:none;text-align:center;font:var(--ui-font,inherit)}
.vk-pager button:hover:not(:disabled),.vk-pager a:hover{border-color:var(--ui-ring)}
.vk-pager button:disabled{opacity:var(--ui-opacity-disabled-pager);cursor:default}
.vk-pager [aria-current="page"]{background:var(--ui-primary);color:var(--ui-primary-fg);border-color:var(--ui-primary)}
.vk-datatable__bar-left{display:flex;align-items:center;gap:calc(var(--ui-space) * 3);flex-wrap:wrap}
.vk-datatable__bar-right{display:flex;align-items:center;gap:calc(var(--ui-space) * 2);margin-left:auto}
.vk-datatable__searchbox{position:relative;display:inline-flex;align-items:center;flex:1;min-width:12rem;max-width:22rem}
.vk-datatable__searchicon{position:absolute;left:calc(var(--ui-space) * 2.4);color:var(--ui-muted);pointer-events:none}
.vk-datatable__search{width:100%;padding-left:calc(var(--ui-space) * 8)}
.vk-sort__ind{color:var(--ui-muted)}
.vk-sort__ind--active{color:var(--ui-primary)}

/* DataTable: the look of shadcn's Table, Input, Button, Pagination and DropdownMenu */
.vk-datatable{position:relative;font-size:var(--ui-font-label)}
.vk-datatable .vk-table-wrap{border:var(--ui-border-width) solid var(--ui-border);border-radius:var(--ui-radius-sm);background:var(--ui-bg)}
.vk-datatable .vk-table-wrap:has(.vk-table--flush){border:0;border-radius:0}
.vk-datatable .vk-table{font-size:var(--ui-font-label)}
.vk-datatable .vk-table th,.vk-datatable .vk-table td{padding:calc(var(--ui-space) * 2) calc(var(--ui-space) * 3)}
.vk-datatable .vk-table thead th{height:calc(var(--ui-space) * 10);padding-block:0;color:var(--ui-muted);font-size:inherit;font-weight:var(--ui-weight-medium);text-transform:none;letter-spacing:normal;white-space:nowrap}
.vk-datatable .vk-table tbody tr:last-child>td{border-bottom:0}
.vk-datatable .vk-table tbody tr{transition:background-color var(--ui-ease)}
.vk-datatable .vk-table tbody tr:hover{background:color-mix(in srgb,var(--ui-subtle) 50%,transparent)}
.vk-datatable .vk-table__empty{padding:calc(var(--ui-space) * 12) calc(var(--ui-space) * 6)}
.vk-datatable .vk-sort{margin:0 calc(var(--ui-space) * -2);padding:calc(var(--ui-space) * 1.5) calc(var(--ui-space) * 2);border-radius:var(--ui-radius-sm);color:inherit;font-weight:inherit;text-decoration:none}
.vk-datatable .vk-sort:hover{background:var(--ui-subtle);color:var(--ui-fg)}
.vk-datatable .vk-sort[aria-sort="ascending"],.vk-datatable .vk-sort[aria-sort="descending"]{color:var(--ui-fg)}
.vk-datatable .vk-sort__ind{opacity:var(--ui-opacity-dismiss)}
.vk-datatable .vk-sort__ind--active{color:var(--ui-fg);opacity:1}
.vk-datatable__searchbox{max-width:20rem}
.vk-datatable .vk-datatable__search{height:calc(var(--ui-space) * 9);min-width:0;max-width:none;padding-block:0;padding-right:calc(var(--ui-space) * 3);border:var(--ui-border-width) solid var(--ui-border);border-radius:var(--ui-radius-sm);background:transparent;box-shadow:var(--ui-shadow-sm);font-size:var(--ui-font-label);transition:border-color var(--ui-ease),box-shadow var(--ui-ease)}
.vk-datatable .vk-datatable__search::placeholder{color:var(--ui-muted)}
.vk-datatable .vk-datatable__search:focus-visible,.vk-datatable__size select:focus-visible,.vk-datatable .vk-sort:focus-visible,.vk-datatable .vk-pager>:focus-visible,.vk-datatable__clear:focus-visible,.vk-menu__trigger:focus-visible{outline:none;border-color:var(--ui-ring);box-shadow:0 0 0 calc(var(--ui-focus-width) + 1px) color-mix(in srgb,var(--ui-ring) 50%,transparent)}
.vk-datatable__foot{font-size:var(--ui-font-label)}
.vk-datatable__count{display:flex;align-items:center;gap:calc(var(--ui-space) * 6);flex-wrap:wrap}
.vk-datatable__count b{color:var(--ui-fg);font-weight:var(--ui-weight-medium);font-variant-numeric:tabular-nums}
.vk-datatable__size{display:inline-flex;align-items:center;gap:calc(var(--ui-space) * 2)}
.vk-datatable__size select{height:calc(var(--ui-space) * 8);padding:0 calc(var(--ui-space) * 2);border:var(--ui-border-width) solid var(--ui-border);border-radius:var(--ui-radius-sm);background:var(--ui-bg);color:var(--ui-fg);box-shadow:var(--ui-shadow-sm);font:inherit;cursor:pointer}
.vk-datatable .vk-pager>a,.vk-datatable .vk-pager>button,.vk-datatable .vk-pager>span[aria-disabled]{display:inline-flex;align-items:center;justify-content:center;gap:var(--ui-space);min-width:calc(var(--ui-space) * 9);height:calc(var(--ui-space) * 9);padding:0 calc(var(--ui-space) * 2.5);border:var(--ui-border-width) solid transparent;border-radius:var(--ui-radius-sm);background:transparent;color:var(--ui-fg);font-size:var(--ui-font-label);font-weight:var(--ui-weight-medium);text-decoration:none;cursor:pointer;transition:background-color var(--ui-ease)}
.vk-datatable .vk-pager>a:hover,.vk-datatable .vk-pager>button:hover:not(:disabled){border-color:transparent;background:var(--ui-subtle)}
.vk-datatable .vk-pager>[aria-current="page"],.vk-datatable .vk-pager>[aria-current="page"]:hover{border-color:var(--ui-border);background:var(--ui-bg);color:var(--ui-fg);box-shadow:var(--ui-shadow-sm)}
.vk-datatable .vk-pager>[aria-disabled="true"],.vk-datatable .vk-pager>button:disabled{opacity:var(--ui-opacity-disabled-pager);cursor:default;pointer-events:none}
.vk-pager__status{padding:0 calc(var(--ui-space) * 2);color:var(--ui-muted);white-space:nowrap}
.vk-pager__status b{color:var(--ui-fg);font-weight:var(--ui-weight-medium)}
.vk-datatable__busy{height:2px;margin-bottom:calc(-2px - var(--ui-space) * 3);border-radius:var(--ui-radius-pill);visibility:hidden;background:linear-gradient(90deg,transparent,var(--ui-primary),transparent) no-repeat;background-size:40% 100%;animation:vk-dt-busy 1.2s linear infinite}
.vk-datatable[aria-busy="true"]>.vk-datatable__busy,.vk-datatable:has([aria-busy="true"])>.vk-datatable__busy{visibility:visible}
.vk-datatable[aria-busy="true"] .vk-table-wrap{opacity:var(--ui-opacity-busy)}
@keyframes vk-dt-busy{0%{background-position:-40% 0}100%{background-position:140% 0}}
.vk-datatable__nomatch{display:flex;flex-direction:column;align-items:center;gap:calc(var(--ui-space) * 1.5);color:var(--ui-muted)}
.vk-datatable__nomatch b{color:var(--ui-fg);font-weight:var(--ui-weight-semibold)}
.vk-datatable__nomatch--client{padding:calc(var(--ui-space) * 12) calc(var(--ui-space) * 6);border:var(--ui-border-width) solid var(--ui-border);border-radius:var(--ui-radius-sm);text-align:center}
.vk-datatable__nomatch--client[hidden]{display:none}
.vk-datatable__clear{display:inline-flex;align-items:center;height:calc(var(--ui-space) * 8);margin-top:calc(var(--ui-space) * 2);padding:0 calc(var(--ui-space) * 3);border:var(--ui-border-width) solid var(--ui-border);border-radius:var(--ui-radius-sm);background:var(--ui-bg);color:var(--ui-fg);box-shadow:var(--ui-shadow-sm);font:inherit;font-weight:var(--ui-weight-medium);text-decoration:none;cursor:pointer}
.vk-datatable__clear:hover{background:var(--ui-subtle)}
.vk-datatable__error{color:var(--ui-danger)}
.vk-datatable .vk-empty__icon:has(.vk-icon[data-vk-icon="warning-circle"]){color:var(--ui-danger)}
.vk-datatable__filtered{color:var(--ui-muted)}
.vk-datatable .vk-col--actions{width:1px;white-space:nowrap}
.vk-menu{display:inline-flex}
.vk-menu__trigger{display:inline-flex;align-items:center;justify-content:center;width:calc(var(--ui-space) * 8);height:calc(var(--ui-space) * 8);padding:0;border:var(--ui-border-width) solid transparent;border-radius:var(--ui-radius-sm);background:transparent;color:var(--ui-muted);cursor:pointer}
.vk-menu__trigger:hover,.vk-menu:has(:popover-open) .vk-menu__trigger{background:var(--ui-subtle);color:var(--ui-fg)}
.vk-menu__panel{width:max-content;min-width:10rem;overflow:visible;padding:var(--ui-space);border:var(--ui-border-width) solid var(--ui-border);border-radius:var(--ui-radius-sm);background:var(--ui-bg);color:var(--ui-fg);box-shadow:var(--ui-shadow-lg);font-size:var(--ui-font-label);text-align:left}
@supports (position-area:bottom){.vk-menu__panel{inset:auto;margin:var(--ui-space) 0 0;position-area:bottom span-left;position-try-fallbacks:flip-block}}
.vk-menu__item{display:flex;width:100%;align-items:center;gap:calc(var(--ui-space) * 2);padding:calc(var(--ui-space) * 1.5) calc(var(--ui-space) * 2);border:0;border-radius:calc(var(--ui-radius-sm) - 2px);background:transparent;color:var(--ui-fg);font:inherit;text-align:left;text-decoration:none;cursor:pointer;outline:none}
.vk-menu__item:hover,.vk-menu__item:focus-visible{background:var(--ui-subtle)}
.vk-menu__item:disabled{opacity:var(--ui-opacity-disabled-control);pointer-events:none}
.vk-menu__item--danger{color:var(--ui-danger)}
.vk-menu__item--danger:hover,.vk-menu__item--danger:focus-visible{background:var(--ui-danger-bg)}
.vk-menu__icon{flex:none;color:var(--ui-muted)}
.vk-menu__item--danger .vk-menu__icon{color:inherit}

/* Icon + spinner */
.vk-icon{display:inline-block;vertical-align:-.125em;width:1em;height:1em;flex:none}
.vk-icon--spin{animation:vk-spin var(--ui-motion-icon) linear infinite}
.vk-spinner{display:inline-block;width:1em;height:1em;border:var(--ui-focus-width) solid currentColor;border-right-color:transparent;border-radius:var(--ui-radius-round);animation:vk-spin var(--ui-motion-spinner) linear infinite}
@keyframes vk-spin{to{transform:rotate(360deg)}}

/* Button */
.vk-btn{--ui-button-fg:var(--ui-fg);--ui-button-bg:var(--ui-subtle);--ui-button-border:var(--ui-border);display:inline-flex;align-items:center;justify-content:center;gap:calc(var(--ui-space) * 1.6);
  font:var(--ui-font,inherit);font-weight:var(--ui-weight-semibold);font-size:var(--ui-font-body);line-height:var(--ui-leading-button);padding:calc(var(--ui-space) * 2) calc(var(--ui-space) * 3.6);border:var(--ui-border-width) solid var(--ui-button-border);border-radius:var(--ui-radius);
  background:var(--ui-button-bg);color:var(--ui-button-fg);cursor:pointer;text-decoration:none;white-space:nowrap;-webkit-appearance:none;appearance:none;transition:filter var(--ui-ease),background var(--ui-ease),border-color var(--ui-ease)}
.vk-btn:hover:not(:disabled):not([aria-disabled="true"]){filter:brightness(var(--ui-hover-brightness))}
.vk-btn:focus-visible{outline:var(--ui-focus-width) solid var(--ui-ring);outline-offset:var(--ui-focus-width)}
.vk-btn:disabled,.vk-btn[aria-disabled="true"]{opacity:var(--ui-opacity-disabled-button);cursor:default}
.vk-btn--sm{padding:calc(var(--ui-space) * 1.2) calc(var(--ui-space) * 2.4);font-size:var(--ui-font-small)}
.vk-btn--lg{padding:calc(var(--ui-space) * 2.6) calc(var(--ui-space) * 4.8);font-size:var(--ui-font-title)}
.vk-btn--icon{padding:calc(var(--ui-space) * 1.8);aspect-ratio:1}
.vk-btn--primary{--ui-button-bg:var(--ui-primary);--ui-button-fg:var(--ui-primary-fg);--ui-button-border:var(--ui-primary)}
.vk-btn--success{--ui-button-bg:var(--ui-success);--ui-button-fg:var(--ui-success-fg);--ui-button-border:var(--ui-success)}
.vk-btn--danger{--ui-button-bg:var(--ui-danger);--ui-button-fg:var(--ui-danger-fg);--ui-button-border:var(--ui-danger)}
.vk-btn--warning{--ui-button-bg:var(--ui-warning);--ui-button-fg:var(--ui-warning-fg);--ui-button-border:var(--ui-warning)}
.vk-btn--info{--ui-button-bg:var(--ui-info);--ui-button-fg:var(--ui-info-fg);--ui-button-border:var(--ui-info)}
.vk-btn--ghost{--ui-button-bg:transparent;--ui-button-border:transparent}
.vk-btn--ghost:hover:not(:disabled){background:var(--ui-subtle)}
.vk-btn__icon{display:inline-flex;align-items:center;font-size:1.05em}
.vk-btn[aria-busy="true"]{pointer-events:none}
.vk-btn[aria-busy="true"] .vk-btn__icon,.vk-form[aria-busy="true"] .vk-btn--submit .vk-btn__icon{display:none}
.vk-btn[aria-busy="true"]::before,.vk-form[aria-busy="true"] .vk-btn--submit::before{content:"";width:1em;height:1em;margin-right:calc(var(--ui-space) * 0.4);border:var(--ui-focus-width) solid currentColor;border-right-color:transparent;border-radius:var(--ui-radius-round);animation:vk-spin var(--ui-motion-spinner) linear infinite}
.vk-form[aria-busy="true"] .vk-btn--submit{opacity:.85}

/* Actions */
.vk-actions{display:flex;gap:calc(var(--ui-space) * 2);align-items:center;justify-content:flex-end;flex-wrap:wrap}

/* Card */
.vk-card{background:var(--ui-bg);border:var(--ui-border-width) solid var(--ui-border);border-radius:var(--ui-radius);box-shadow:var(--ui-shadow-sm)}
.vk-card__header{display:flex;align-items:center;gap:calc(var(--ui-space) * 4);padding:calc(var(--ui-space) * 3.6) calc(var(--ui-space) * 4.6);border-bottom:var(--ui-border-width) solid var(--ui-border)}
.vk-card__title{font-weight:var(--ui-weight-semibold);font-size:var(--ui-font-title);display:flex;align-items:center;gap:calc(var(--ui-space) * 2)}
.vk-card__header-actions{margin-left:auto;display:flex;align-items:center;gap:calc(var(--ui-space) * 2)}
.vk-card__body{padding:calc(var(--ui-space) * 4.6)}
.vk-card__body--flush{padding:0}

/* Tile */
.vk-tile-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:calc(var(--ui-space) * 4)}
.vk-tile{display:flex;align-items:center;gap:calc(var(--ui-space) * 3.6);padding:calc(var(--ui-space) * 4) calc(var(--ui-space) * 4.6);background:var(--ui-bg);border:var(--ui-border-width) solid var(--ui-border);border-radius:var(--ui-radius)}
.vk-tile__icon{display:inline-flex;align-items:center;justify-content:center;width:2.6rem;height:2.6rem;border-radius:var(--ui-radius-round);font-size:var(--ui-font-tile-icon);flex:none;
  background:color-mix(in srgb,var(--ui-primary) var(--ui-accent-mix),transparent);color:var(--ui-primary)}
.vk-tile__icon--success{background:color-mix(in srgb,var(--ui-success) var(--ui-soft-mix),transparent);color:var(--ui-success)}
.vk-tile__icon--danger{background:color-mix(in srgb,var(--ui-danger) var(--ui-soft-mix),transparent);color:var(--ui-danger)}
.vk-tile__icon--warning{background:color-mix(in srgb,var(--ui-warning) var(--ui-soft-mix),transparent);color:var(--ui-warning)}
.vk-tile__icon--info{background:color-mix(in srgb,var(--ui-info) var(--ui-soft-mix),transparent);color:var(--ui-info)}
.vk-tile__value{font-size:var(--ui-font-stat);font-weight:var(--ui-weight-bold);line-height:var(--ui-leading-stat)}
.vk-tile__label{color:var(--ui-muted);font-size:var(--ui-font-label);margin-top:calc(var(--ui-space) * 0.4)}

/* Badge */
.vk-badge{display:inline-flex;align-items:center;gap:calc(var(--ui-space) * 1.2);padding:calc(var(--ui-space) * 0.6) calc(var(--ui-space) * 2);font-size:var(--ui-font-badge);font-weight:var(--ui-weight-semibold);line-height:var(--ui-leading-badge);border-radius:var(--ui-radius-pill);background:var(--ui-subtle);color:var(--ui-fg)}
.vk-badge--primary{background:var(--ui-primary);color:var(--ui-primary-fg)}
.vk-badge--success{background:var(--ui-success);color:var(--ui-success-fg)}
.vk-badge--danger{background:var(--ui-danger);color:var(--ui-danger-fg)}
.vk-badge--warning{background:var(--ui-warning);color:var(--ui-warning-fg)}
.vk-badge--info{background:var(--ui-info);color:var(--ui-info-fg)}
.vk-badge--soft.vk-badge--primary{color:var(--ui-primary);background:color-mix(in srgb,var(--ui-primary) var(--ui-soft-mix),transparent)}
.vk-badge--soft.vk-badge--success{color:var(--ui-success);background:color-mix(in srgb,var(--ui-success) var(--ui-soft-mix),transparent)}
.vk-badge--soft.vk-badge--danger{color:var(--ui-danger);background:color-mix(in srgb,var(--ui-danger) var(--ui-soft-mix),transparent)}
.vk-badge--soft.vk-badge--warning{color:var(--ui-warning);background:color-mix(in srgb,var(--ui-warning) var(--ui-soft-mix),transparent)}
.vk-badge--soft.vk-badge--info{color:var(--ui-info);background:color-mix(in srgb,var(--ui-info) var(--ui-soft-mix),transparent)}

/* Tabs */
.vk-tabs{display:flex;gap:var(--ui-space);border-bottom:var(--ui-border-width) solid var(--ui-border);margin-bottom:calc(var(--ui-space) * 4);overflow-x:auto;scrollbar-width:none;-ms-overflow-style:none}
.vk-tabs::-webkit-scrollbar{width:0;height:0;display:none}
.vk-tab{display:inline-flex;align-items:center;gap:calc(var(--ui-space) * 1.6);padding:calc(var(--ui-space) * 2.4) calc(var(--ui-space) * 3.6);border:0;border-bottom:2px solid transparent;background:transparent;color:var(--ui-muted);
  font:var(--ui-font,inherit);font-weight:var(--ui-weight-semibold);font-size:var(--ui-font-body);cursor:pointer;text-decoration:none;white-space:nowrap;margin-bottom:-1px}
.vk-tab:hover{color:var(--ui-fg)}
.vk-tab--active{color:var(--ui-primary);border-bottom-color:var(--ui-primary)}
.vk-tab:focus-visible{outline:var(--ui-focus-width) solid var(--ui-ring);outline-offset:calc(-1 * var(--ui-focus-width))}
.vk-tab__count{display:inline-flex;align-items:center;justify-content:center;min-width:1.4em;padding:0 .35em;font-size:var(--ui-font-caption);border-radius:var(--ui-radius-pill);
  background:color-mix(in srgb,var(--ui-primary) var(--ui-soft-mix),transparent);color:var(--ui-primary)}

/* Form + fields */
.vk-form{display:flex;flex-direction:column;gap:calc(var(--ui-space) * 4)}
.vk-field{display:flex;flex-direction:column;gap:calc(var(--ui-space) * 1.4)}
.vk-field__label{font-weight:var(--ui-weight-semibold);font-size:var(--ui-font-label)}
.vk-field__req{color:var(--ui-danger);margin-left:calc(var(--ui-space) * 0.6)}
.vk-input,.vk-select,.vk-textarea{width:100%;font:var(--ui-font,inherit);font-size:var(--ui-font-body);padding:calc(var(--ui-space) * 2) calc(var(--ui-space) * 2.6);border:var(--ui-border-width) solid var(--ui-border);border-radius:var(--ui-radius);background:var(--ui-bg);color:var(--ui-fg)}
.vk-input,.vk-textarea{-webkit-appearance:none;appearance:none}
.vk-textarea{resize:vertical;min-height:4.5rem}
.vk-input::placeholder,.vk-textarea::placeholder{color:var(--ui-muted)}
.vk-input:focus,.vk-select:focus,.vk-textarea:focus{outline:var(--ui-focus-width) solid var(--ui-ring);outline-offset:-1px;border-color:var(--ui-ring)}
.vk-input:disabled,.vk-select:disabled,.vk-textarea:disabled{opacity:var(--ui-opacity-disabled-control);cursor:not-allowed}
.vk-input--invalid,.vk-select--invalid,.vk-textarea--invalid{border-color:var(--ui-danger)}
.vk-input--invalid:focus,.vk-select--invalid:focus,.vk-textarea--invalid:focus{outline-color:var(--ui-danger);border-color:var(--ui-danger)}
.vk-field__help{font-size:var(--ui-font-small);color:var(--ui-muted)}
.vk-field__error{font-size:var(--ui-font-small);color:var(--ui-danger)}
.vk-check{display:inline-flex;align-items:center;gap:calc(var(--ui-space) * 2);cursor:pointer;font-size:var(--ui-font-body)}
.vk-check__box{width:1rem;height:1rem;accent-color:var(--ui-primary);flex:none}
.vk-field__marker{font-weight:var(--ui-weight-normal);color:var(--ui-muted)}
.vk-field--invalid{border-left:var(--ui-accent-width) solid var(--ui-danger);padding-left:calc(var(--ui-space) * 3)}
.vk-field__error{font-weight:var(--ui-weight-semibold)}
.vk-field__reveal{align-self:flex-start;font:var(--ui-font,inherit);font-size:var(--ui-font-small);padding:calc(var(--ui-space) * 0.8) calc(var(--ui-space) * 2);border:var(--ui-border-width) solid var(--ui-border);border-radius:var(--ui-radius);background:var(--ui-bg);color:var(--ui-fg);cursor:pointer}
.vk-field__reveal[aria-pressed="true"]{background:color-mix(in srgb,var(--ui-primary) var(--ui-accent-mix),transparent)}
.vk-field__ok{color:var(--ui-success);font-weight:var(--ui-weight-bold);font-size:var(--ui-font-body)}
.vk-field__update{align-self:flex-start}
.vk-fieldset{border:0;margin:0;padding:0;display:flex;flex-direction:column;gap:calc(var(--ui-space) * 2);min-width:0}
.vk-fieldset__legend{font-weight:var(--ui-weight-semibold);font-size:var(--ui-font-body);padding:0;margin-bottom:var(--ui-space)}
.vk-choices{display:flex;flex-direction:column;gap:calc(var(--ui-space) * 1.6)}
.vk-form__error{display:contents}
.vk-summary{border:var(--ui-summary-width) solid var(--ui-danger);border-radius:var(--ui-radius);padding:calc(var(--ui-space) * 3.6) calc(var(--ui-space) * 4)}
.vk-summary:focus{outline:var(--ui-summary-width) solid var(--ui-ring);outline-offset:var(--ui-focus-width)}
.vk-summary__title{margin:0 0 calc(var(--ui-space) * 2);font-size:var(--ui-font-heading)}
.vk-summary__list{margin:0;padding-left:calc(var(--ui-space) * 4.4);display:flex;flex-direction:column;gap:var(--ui-space)}
.vk-summary__list a{color:var(--ui-danger);font-weight:var(--ui-weight-semibold)}
.vk-sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.vk-file{display:flex;flex-direction:column;gap:calc(var(--ui-space) * 1.6);align-items:flex-start}
.vk-file__input{font:var(--ui-font,inherit);font-size:var(--ui-font-body)}
.vk-file__input:focus-visible{outline:var(--ui-focus-width) solid var(--ui-ring);outline-offset:var(--ui-focus-width)}
.vk-file__input--invalid{outline:var(--ui-focus-width) solid var(--ui-danger);outline-offset:var(--ui-focus-width)}
.vk-file__input--held{position:absolute;width:1px;height:1px;opacity:0;overflow:hidden}
.vk-file__held{margin:0;font-size:var(--ui-font-body)}
.vk-file__name{font-weight:var(--ui-weight-semibold)}
.vk-file__ok{color:var(--ui-success)}
.vk-file__change{color:var(--ui-primary);text-decoration:underline;cursor:pointer}
.vk-file__input--held:focus-visible+.vk-file__progress,.vk-file:has(.vk-file__input--held:focus-visible) .vk-file__change{outline:var(--ui-focus-width) solid var(--ui-ring);outline-offset:var(--ui-focus-width)}
.vk-file__progress{width:100%;max-width:20rem;accent-color:var(--ui-primary)}
.vk-file__progress[hidden]{display:none}

/* Table additions */
.vk-table--flush{border:0}
.vk-col--select,.vk-col--index{width:1px;white-space:nowrap}
.vk-col--index{color:var(--ui-muted)}
.vk-table tbody tr.vk-row--selected{background:color-mix(in srgb,var(--ui-primary) var(--ui-selected-mix),transparent)}
.vk-empty{display:flex;flex-direction:column;align-items:center;gap:calc(var(--ui-space) * 2);color:var(--ui-muted)}
.vk-empty__icon{font-size:var(--ui-font-empty);opacity:.65}
.vk-empty__msg{font-size:var(--ui-font-body)}

/* Modal additions */
.vk-modal--xl{max-width:64rem}
.vk-modal__header{justify-content:flex-start;gap:calc(var(--ui-space) * 3)}
.vk-modal__icon{display:inline-flex;align-items:center;justify-content:center;width:2.2rem;height:2.2rem;border-radius:var(--ui-radius);font-size:var(--ui-font-modal-icon);flex:none;
  background:color-mix(in srgb,var(--ui-primary) var(--ui-accent-mix),transparent);color:var(--ui-primary)}
.vk-modal__heading{flex:1;min-width:0}
.vk-modal__subtitle{margin:calc(var(--ui-space) * 0.6) 0 0;color:var(--ui-muted);font-size:var(--ui-font-label)}
.vk-modal__close .vk-icon{font-size:var(--ui-font-modal-close)}

@media (prefers-reduced-motion:reduce){.vk-spinner,.vk-icon--spin,.vk-btn[aria-busy="true"]::before,.vk-form[aria-busy="true"] .vk-btn--submit::before{animation-duration:var(--ui-motion-reduced)}}
@media (max-width:960px){.vk-tile-grid{grid-template-columns:repeat(2,1fr)}}
@media (max-width:640px){
  .vk-table thead th{font-size:var(--ui-font-caption)}
  .vk-datatable__bar,.vk-datatable__foot{gap:calc(var(--ui-space) * 2)}
  .vk-datatable__bar{flex-direction:column;align-items:stretch}
  .vk-datatable__bar-right{margin-left:0}
  .vk-tile-grid{grid-template-columns:1fr}
}
.vk-img{background-color:var(--ui-image-bg);background-image:linear-gradient(90deg,transparent,var(--ui-image-shimmer),transparent);background-size:200% 100%;background-repeat:no-repeat;animation:vk-img-shimmer var(--ui-motion-shimmer) ease infinite}
.vk-img--plain{background:none;animation:none}
@keyframes vk-img-shimmer{0%{background-position:200% 0}100%{background-position:-200% 0}}
.vk-img-wrap{position:relative;overflow:hidden}
.vk-img-scrim{position:absolute;inset:0;pointer-events:none;background:linear-gradient(to top,var(--ui-image-scrim-start),var(--ui-image-scrim-end),transparent)}
.vk-img-overlay{position:absolute;inset:0}
@media (prefers-reduced-motion:reduce){.vk-img{animation:none}}

/* Skeleton */
.vk-skeleton{display:block;min-height:1em;border-radius:var(--ui-radius-sm);background:var(--ui-subtle);animation:vk-skeleton-pulse var(--ui-motion-skeleton) infinite}
.vk-skeleton-lines{display:flex;flex-direction:column;gap:calc(var(--ui-space) * 2)}
.vk-skeleton--line{height:1rem} .vk-skeleton--last{width:60%}
@keyframes vk-skeleton-pulse{50%{opacity:var(--ui-opacity-pulse)}}
@media (prefers-reduced-motion:reduce){.vk-skeleton{animation:none}}

.vk-call-bare__error{margin:0;color:var(--ui-danger)}
</style></main>
